🎮 QUICK TEST COMMANDS
───────────────────────────────────────────────────────
  # Get Jam 1 live state (PLAYING)
  GET /api/jams/{jam1Id}/live/state

  # Start Jam 3 (STOPPED → PLAYING)
  POST /api/jams/{jam3Id}/control/start

  # Skip to next song
  POST /api/jams/{jamId}/control/next

  # Pause current song
  POST /api/jams/{jamId}/control/pause

  # Resume paused song
  POST /api/jams/{jamId}/control/resume

  # Go back to previous song
  POST /api/jams/{jamId}/control/previous

  # Stop the jam completely
  POST /api/jams/{jamId}/control/stop

  # Get playback history
  GET /api/jams/{jamId}/playback-history

